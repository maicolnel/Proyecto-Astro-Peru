---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.tsx';

const base = '/Proyecto-Astro-Peru/';


const images = [
  { src: `${base}img/gastronomia/ceviche.jpg`, thumb: `${base}img/gastronomia/ceviche.jpg`, alt: 'Ceviche', title: 'Ceviche', description: 'Plato frío de pescado marinado en jugo de limón con cebolla y ají.' },
  { src: `${base}img/gastronomia/lomo-saltado.jpg`, thumb: `${base}img/gastronomia/lomo-saltado.jpg`, alt: 'Lomo Saltado', title: 'Lomo Saltado', description: 'Salteado de carne de res con verduras, salsa de soja y papas fritas.' },
  { src: `${base}img/gastronomia/aji-de-gallina.jpg`, thumb: `${base}img/gastronomia/aji-de-gallina.jpg`, alt: 'Ají de Gallina', title: 'Ají de Gallina', description: 'Guiso cremoso y picante de pollo deshilachado con crema y ají amarillo.' },
  { src: `${base}img/gastronomia/papa-a-la-huancaina.jpg`, thumb: `${base}img/gastronomia/papa-a-la-huancaina.jpg`, alt: 'Papa a la Huancaína', title: 'Papa a la Huancaína', description: 'Papas sancochadas cubiertas con salsa de queso y ají amarillo.' },
  { src: `${base}img/gastronomia/anticuchos.jpg`, thumb: `${base}img/gastronomia/anticuchos.jpg`, alt: 'Anticuchos', title: 'Anticuchos', description: 'Brochetas de carne marinada y a la parrilla, típicas de la comida callejera.' },
  { src: `${base}img/gastronomia/arroz-chaufa.jpg`, thumb: `${base}img/gastronomia/arroz-chaufa.jpg`, alt: 'Arroz Chaufa', title: 'Arroz Chaufa', description: 'Arroz frito con verduras, huevos y soja, fusión de cocina china y peruana.' },
  { src: `${base}img/gastronomia/causa-limena.jpg`, thumb: `${base}img/gastronomia/causa-limena.jpg`, alt: 'Causa Limeña', title: 'Causa Limeña', description: 'Pastel frío de papa amarilla con pollo, huevo y mayonesa en capas.' },
  { src: `${base}img/gastronomia/pachamanca.jpg`, thumb: `${base}img/gastronomia/pachamanca.jpg`, alt: 'Pachamanca', title: 'Pachamanca', description: 'Guiso tradicional cocido bajo tierra con hierbas aromáticas y carnes.' },
  { src: `${base}img/gastronomia/pollo-a-la-brasa.jpg`, thumb: `${base}img/gastronomia/pollo-a-la-brasa.jpg`, alt: 'Pollo a la Brasa', title: 'Pollo a la Brasa', description: 'Pollo rostizado con condimentos y especias, plato nacional peruano.' },
  { src: `${base}img/gastronomia/rocoto-relleno.jpg`, thumb: `${base}img/gastronomia/rocoto-relleno.jpg`, alt: 'Rocoto Relleno', title: 'Rocoto Relleno', description: 'Ají rocoto relleno con carne, queso y especias horneado con salsa.' },
  { src: `${base}img/gastronomia/arroz-con-pato.jpg`, thumb: `${base}img/gastronomia/arroz-con-pato.jpg`, alt: 'Arroz con Pato', title: 'Arroz con Pato', description: 'Arroz sazonado con cerveza negra y servido con pato guisado.' },
  { src: `${base}img/gastronomia/tacacho-cecina.jpg`, thumb: `${base}img/gastronomia/tacacho-cecina.jpg`, alt: 'Tacacho con Cecina', title: 'Tacacho con Cecina', description: 'Plato amazónico de plátano machacado con carne seca ahumada.' },
  { src: `${base}img/gastronomia/juane.jpg`, thumb: `${base}img/gastronomia/juane.jpg`, alt: 'Juane', title: 'Juane', description: 'Arroz sazonado con especias, envuelto en hoja de bijao y cocido al vapor.' },
  { src: `${base}img/gastronomia/cuy-chactado.jpg`, thumb: `${base}img/gastronomia/cuy-chactado.jpg`, alt: 'Cuy Chactado', title: 'Cuy Chactado', description: 'Cuy frito servido crocante, plato tradicional andino.' },
  { src: `${base}img/gastronomia/chupe-de-camarones.jpg`, thumb: `${base}img/gastronomia/chupe-de-camarones.jpg`, alt: 'Chupe de Camarones', title: 'Chupe de Camarones', description: 'Sopa cremosa de camarones con papa, queso, arroz y maíz.' },
  { src: `${base}img/gastronomia/mazamorra-morada.jpg`, thumb: `${base}img/gastronomia/mazamorra-morada.jpg`, alt: 'Mazamorra Morada', title: 'Mazamorra Morada', description: 'Postre dulce de maíz morado con frutas secas y especias.' },
  { src: `${base}img/gastronomia/arroz-con-mariscos.jpg`, thumb: `${base}img/gastronomia/arroz-con-mariscos.jpg`, alt: 'Arroz con Mariscos', title: 'Arroz con Mariscos', description: 'Arroz cocido con variedad de mariscos frescos y especias.' },
  { src: `${base}img/gastronomia/causa-rellena.jpg`, thumb: `${base}img/gastronomia/causa-rellena.jpg`, alt: 'Causa Rellena', title: 'Causa Rellena', description: 'Causa fría con capas rellenas de pollo, mariscos o verduras.' },
  { src: `${base}img/gastronomia/estofado-de-pollo.jpg`, thumb: `${base}img/gastronomia/estofado-de-pollo.jpg`, alt: 'Estofado de Pollo', title: 'Estofado de Pollo', description: 'Guiso de pollo con verduras en salsa espesa y sabor tradicional.' },
  { src: `${base}img/gastronomia/olluquito-con-charqui.jpg`, thumb: `${base}img/gastronomia/olluquito-con-charqui.jpg`, alt: 'Olluquito con Charqui', title: 'Olluquito con Charqui', description: 'Plato andino con tubérculo olluco y carne seca (charqui).' }
];

---

<Layout title="Gastronomía Peruana">
  <div class="page-container">
    <header class="page-header" data-aos="fade-in">
      <h1>Sabor a Perú</h1>
      <p>Una de las cocinas más celebradas del mundo.</p>
    </header>
    <section class="section-container">
      <Gallery images={images} client:visible />
    </section>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.tsx';

const base = '/Proyecto-Astro-Peru/';

const images = [
  { src: `${base}img/gastronomia/ceviche.jpg`, thumb: `${base}img/gastronomia/ceviche.jpg`, alt: 'Ceviche', title: 'Ceviche' },
  { src: `${base}img/gastronomia/lomo-saltado.jpg`, thumb: `${base}img/gastronomia/lomo-saltado.jpg`, alt: 'Lomo Saltado', title: 'Lomo Saltado' },
  { src: `${base}img/gastronomia/aji-de-gallina.jpg`, thumb: `${base}img/gastronomia/aji-de-gallina.jpg`, alt: 'Ají de Gallina', title: 'Ají de Gallina' },
  { src: `${base}img/gastronomia/papa-a-la-huancaina.jpg`, thumb: `${base}img/gastronomia/papa-a-la-huancaina.jpg`, alt: 'Papa a la Huancaína', title: 'Papa a la Huancaína' },
  { src: `${base}img/gastronomia/anticuchos.jpg`, thumb: `${base}img/gastronomia/anticuchos.jpg`, alt: 'Anticuchos', title: 'Anticuchos' },
  { src: `${base}img/gastronomia/arroz-chaufa.jpg`, thumb: `${base}img/gastronomia/arroz-chaufa.jpg`, alt: 'Arroz Chaufa', title: 'Arroz Chaufa' },
  { src: `${base}img/gastronomia/causa-limena.jpg`, thumb: `${base}img/gastronomia/causa-limena.jpg`, alt: 'Causa Limeña', title: 'Causa Limeña' },
  { src: `${base}img/gastronomia/pachamanca.jpg`, thumb: `${base}img/gastronomia/pachamanca.jpg`, alt: 'Pachamanca', title: 'Pachamanca' },
  { src: `${base}img/gastronomia/pollo-a-la-brasa.jpg`, thumb: `${base}img/gastronomia/pollo-a-la-brasa.jpg`, alt: 'Pollo a la Brasa', title: 'Pollo a la Brasa' },
  { src: `${base}img/gastronomia/rocoto-relleno.jpg`, thumb: `${base}img/gastronomia/rocoto-relleno.jpg`, alt: 'Rocoto Relleno', title: 'Rocoto Relleno' },
  { src: `${base}img/gastronomia/arroz-con-pato.jpg`, thumb: `${base}img/gastronomia/arroz-con-pato.jpg`, alt: 'Arroz con Pato', title: 'Arroz con Pato' },
  { src: `${base}img/gastronomia/tacacho-cecina.jpg`, thumb: `${base}img/gastronomia/tacacho-cecina.jpg`, alt: 'Tacacho con Cecina', title: 'Tacacho con Cecina' },
  { src: `${base}img/gastronomia/juane.jpg`, thumb: `${base}img/gastronomia/juane.jpg`, alt: 'Juane', title: 'Juane' },
  { src: `${base}img/gastronomia/cuy-chactado.jpg`, thumb: `${base}img/gastronomia/cuy-chactado.jpg`, alt: 'Cuy Chactado', title: 'Cuy Chactado' },
  { src: `${base}img/gastronomia/chupe-de-camarones.jpg`, thumb: `${base}img/gastronomia/chupe-de-camarones.jpg`, alt: 'Chupe de Camarones', title: 'Chupe de Camarones' },
  { src: `${base}img/gastronomia/mazamorra-morada.jpg`, thumb: `${base}img/gastronomia/mazamorra-morada.jpg`, alt: 'Mazamorra Morada', title: 'Mazamorra Morada' },
  { src: `${base}img/gastronomia/arroz-con-mariscos.jpg`, thumb: `${base}img/gastronomia/arroz-con-mariscos.jpg`, alt: 'Arroz con Mariscos', title: 'Arroz con Mariscos' },
  { src: `${base}img/gastronomia/causa-rellena.jpg`, thumb: `${base}img/gastronomia/causa-rellena.jpg`, alt: 'Causa Rellena', title: 'Causa Rellena' },
  { src: `${base}img/gastronomia/estofado-de-pollo.jpg`, thumb: `${base}img/gastronomia/estofado-de-pollo.jpg`, alt: 'Estofado de Pollo', title: 'Estofado de Pollo' },
  { src: `${base}img/gastronomia/olluquito-con-charqui.jpg`, thumb: `${base}img/gastronomia/olluquito-con-charqui.jpg`, alt: 'Olluquito con Charqui', title: 'Olluquito con Charqui' }
];


<Layout title="Gastronomía Peruana">
  <div class="page-container">
    <header class="page-header" data-aos="fade-in">
      <h1>Sabor a Perú</h1>
      <p>Una de las cocinas más celebradas del mundo.</p>
    </header>
    <section class="section-container">
      <Gallery images={images} client:visible />
    </section>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.tsx';
import MusicList from '../components/MusicList.tsx';

const base = '/Proyecto-Astro-Peru/';

const instruments = [
  { src: `${base}img/musica/cajon.jpg`, thumb: `${base}img/musica/cajon.jpg`, alt: 'Cajón Peruano', title: 'El Cajón: Ritmo Afroperuano', description: 'Instrumento de percusión de origen afroperuano, símbolo del festejo y la música criolla.' },
  { src: `${base}img/musica/quena.jpg`, thumb: `${base}img/musica/quena.jpg`, alt: 'Quena Andina', title: 'La Quena: Viento de los Andes', description: 'Flauta de siete agujeros típica de la música andina, con un sonido melódico y dulce.' },
  { src: `${base}img/musica/charango.jpg`, thumb: `${base}img/musica/charango.jpg`, alt: 'Charango', title: 'El Charango: Corazón de Cuerdas', description: 'Pequeña guitarra andina con cinco pares de cuerdas, usada en valses y huaynos.' },
  { src: `${base}img/musica/zampoña.jpg`, thumb: `${base}img/musica/zampoña.jpg`, alt: 'Zampoña', title: 'La Zampona: Ritmo de la Sierra', description: 'Conjunto de tubos paralelos que forman un instrumento de viento tradicional andino.' },
  { src: `${base}img/musica/arpa-andina.jpg`, thumb: `${base}img/musica/arpa-andina.jpg`, alt: 'Arpa Andina', title: 'El Arpa Andina: Dulzura y Tradición', description: 'Instrumento de cuerdas adaptado en los Andes, base de huaynos y melodías tradicionales.' },
  { src: `${base}img/musica/guitarra-criolla.jpg`, thumb: `${base}img/musica/guitarra-criolla.jpg`, alt: 'Guitarra Criolla', title: 'La Guitarra: Voz de los Andes', description: 'Instrumento de cuerdas usado en géneros como la marinera, vals y música criolla peruana.' },
  { src: `${base}img/musica/pututo.jpg`, thumb: `${base}img/musica/pututo.jpg`, alt: 'Pututo', title: 'El Pututo: Llamado ancestral', description: 'Instrumento de viento hecho con caracolas marinas, usado en ceremonias y fiestas andinas.' },
  { src: `${base}img/musica/clarin-cajamarquino.jpg`, thumb: `${base}img/musica/clarin-cajamarquino.jpg`, alt: 'Clarín Cajamarquino', title: 'El Clarín Cajamarquino: Sonido monumental', description: 'Trompeta de hasta 4 metros, patrimonio cultural de Cajamarca.' },
  { src: `${base}img/musica/bandurria-cusquena.jpg`, thumb: `${base}img/musica/bandurria-cusquena.jpg`, alt: 'Bandurria Cusqueña', title: 'La Bandurria Cusqueña: Dulce resonar', description: 'Instrumento de cuerda usado en carnavales y festividades andinas del Cusco.' },
  { src: `${base}img/musica/guira.jpg`, thumb: `${base}img/musica/guira.jpg`, alt: 'Guira', title: 'La Güira: Percusión vibrante', description: 'Instrumento rítmico típico en la costa peruana, usado en música afroperuana.' },
  { src: `${base}img/musica/cajita-ritmica.jpg`, thumb: `${base}img/musica/cajita-ritmica.jpg`, alt: 'Cajita Rítmica', title: 'Cajita Rítmica: Latidos del Perú', description: 'Instrumento pequeño de percusión con sonido cortante, popular en la costa.' },
  { src: `${base}img/musica/maracas.jpg`, thumb: `${base}img/musica/maracas.jpg`, alt: 'Maracas', title: 'Maracas: Sonidos de tradición', description: 'Instrumento de percusión hecho con semillas seca, usado en danzas y festivales.' },
  { src: `${base}img/musica/ocarina.jpg`, thumb: `${base}img/musica/ocarina.jpg`, alt: 'Ocarina', title: 'La Ocarina: Voz del viento', description: 'Instrumento de viento con profundo significado ancestral y sonido suave.' },
  { src: `${base}img/musica/bombo.jpg`, thumb: `${base}img/musica/bombo.jpg`, alt: 'Bombo Peruano', title: 'El Bombo Peruano: Pulso de la tierra', description: 'Tambor grande que marca el ritmo en festivales y música tradicional.' },
  { src: `${base}img/musica/sikus.jpg`, thumb: `${base}img/musica/sikus.jpg`, alt: 'Sikus', title: 'Sikus: Melodías de tubos', description: 'Instrumento parecido a la zampoña, típico en regiones andinas.' },
  { src: `${base}img/musica/caja.jpg`, thumb: `${base}img/musica/caja.jpg`, alt: 'Caja Peruana', title: 'La Caja: Sonido afroperuano', description: 'Tambor pequeño con sonido agudo, esencial en música criolla.' },
  { src: `${base}img/musica/tinya.jpg`, thumb: `${base}img/musica/tinya.jpg`, alt: 'Tinya', title: 'La Tinya: Tambor andino', description: 'Pequeño tambor usado en danzas tradicionales andinas.' },
  { src: `${base}img/musica/chajchas.jpg`, thumb: `${base}img/musica/chajchas.jpg`, alt: 'Chajchas', title: 'Las Chajchas: Sonidos de cerdas', description: 'Sonajeros hechos con uñas o cerdas de animales, usados en rituales.' },
  { src: `${base}img/musica/wajrapukara.jpg`, thumb: `${base}img/musica/wajrapukara.jpg`, alt: 'Wajrapukara', title: 'El Wajrapukara: Instrumento ancestral', description: 'Instrumento de viento de madera usado en ceremonias andinas.' },
  { src: `${base}img/musica/chirimia.jpg`, thumb: `${base}img/musica/chirimia.jpg`, alt: 'Chirimía', title: 'La Chirimía: Sonidos folclóricos', description: 'Instrumento de viento que acompaña muchas danzas folclóricas peruanas.' }
];


const tracks = [
  { id: 'la-anaconda', src: `${base}music/La anaconda.mp3`, title: 'La Anaconda', description: 'Clásico de la música tropical peruana.' },
  { id: 'shipbo-enamorado', src: `${base}music/Shipbo Enamorado.mp3`, title: 'Shipbo Enamorado', description: 'Música amazónica del Perú.' },
  { id: 'el-bonbon-asesino', src: `${base}music/El Bonbon Asesino.mp3`, title: 'El Bonbón Asesino', description: 'Éxito de la música chicha peruana.' },
  { id: 'triste-payaso', src: `${base}music/Triste Payaso.mp3`, title: 'Triste Payaso', description: 'Balada criolla peruana.' },
  { id: 'una-aventura-mas', src: `${base}music/Una aventura mas.mp3`, title: 'Una Aventura Más', description: 'Canción romántica peruana.' },
  { id: 'esta-noche', src: `${base}music/Esta Noche - Orquesta Candela.mp3`, title: 'Esta Noche - Orquesta Candela', description: 'Salsa peruana moderna.' },
  { id: 'solo', src: `${base}music/Solo.mp3`, title: 'Solo', description: 'Balada peruana contemporánea.' },
  { id: 'juramentos', src: `${base}music/Juramentos.mp3`, title: 'Juramentos', description: 'Clásico de la música criolla.' },
  { id: 'jipi-jay', src: `${base}music/Jipi Jay.mp3`, title: 'Jipi Jay', description: 'Música festiva peruana.' },
  { id: 'que-paso', src: `${base}music/Que Pasó - Papillón.mp3`, title: 'Qué Pasó - Papillón', description: 'Cumbia peruana moderna.' },
  { id: 'el-embrujo', src: `${base}music/El Embrujo.mp3`, title: 'El Embrujo', description: 'Música afroperuana tradicional.' },
  { id: 'siqui-siqui', src: `${base}music/Siqui Siqui.mp3`, title: 'Siqui Siqui', description: 'Canción infantil peruana popular.' },
  { id: 'damaris-tusuy', src: `${base}music/Damaris - TusuyKusun.mp3`, title: 'Damaris - Tusuy Kusun', description: 'Música andina en quechua.' },
  { id: 'tupay-caporal', src: `${base}music/Tupay - Soy Caporal.mp3`, title: 'Tupay - Soy Caporal', description: 'Música de danza andina.' },
  { id: 'mal-paso', src: `${base}music/Mal Paso.mp3`, title: 'Mal Paso', description: 'Canción criolla peruana.' },
  { id: 'que-linda-flor', src: `${base}music/Que linda flor.mp3`, title: 'Qué Linda Flor', description: 'Vals peruano romántico.' },
  { id: 'esta-es-mi-tierra', src: `${base}music/Esta es mi tierra.mp3`, title: 'Esta es Mi Tierra', description: 'Canción patriótica peruana.' },
  { id: 'agua-marina', src: `${base}music/AGUA MARINA.mp3`, title: 'Agua Marina', description: 'Cumbia norteña peruana.' },
  { id: 'el-condor-pasa', src: `${base}music/El Condor Pasa.mp3`, title: 'El Cóndor Pasa', description: 'Himno musical del Perú, conocido mundialmente.' },
  { id: 'ni-siquiera', src: `${base}music/Ni siquiera.mp3`, title: 'Ni Siquiera', description: 'Balada peruana moderna.' },
  { id: 'me-vas-extrañar', src: `${base}music/ME VAS A EXTRAÑAR.mp3`, title: 'Me Vas a Extrañar', description: 'Canción romántica peruana.' },
  { id: 'you-salsa', src: `${base}music/You Salsa.mp3`, title: 'You Salsa', description: 'Salsa peruana contemporánea.' },
  { id: 'probablemente', src: `${base}music/Probablemente.mp3`, title: 'Probablemente', description: 'Balada pop peruana.' },
  { id: 'con-la-misma-moneda', src: `${base}music/Con La Misma Moneda.mp3`, title: 'Con La Misma Moneda', description: 'Canción de desamor peruana.' },
  { id: 'quiereme', src: `${base}music/Quiereme.mp3`, title: 'Quiéreme', description: 'Canción romántica criolla.' },
  { id: 'la-revancha', src: `${base}music/La Revancha.mp3`, title: 'La Revancha', description: 'Música popular peruana.' },
  { id: 'raices-festejo', src: `${base}music/Raíces del Festejo.mp3`, title: 'Raíces del Festejo', description: 'Festejo afroperuano tradicional.' },
  { id: 'jamas-impediran', src: `${base}music/Jamás Impedirán.mp3`, title: 'Jamás Impedirán', description: 'Canción de protesta social peruana.' },
  { id: 'los-kipus', src: `${base}music/Los Kipus.mp3`, title: 'Los Kipus', description: 'Música andina tradicional.' },
  { id: 'regresa', src: `${base}music/Regresa.mp3`, title: 'Regresa', description: 'Balada romántica peruana.' },
  { id: 'motor-y-motivo', src: `${base}music/Motor y Motivo.mp3`, title: 'Motor y Motivo', description: 'Música criolla contemporánea.' },
  { id: 'contigo-peru', src: `${base}music/Contigo Peru.mp3`, title: 'Contigo Perú', description: 'Canción patriótica emblemática.' },
  { id: 'negrito-chichivi', src: `${base}music/Negrito Chichivi.mp3`, title: 'Negrito Chichivi', description: 'Festejo afroperuano clásico.' },
  { id: 'ritmo-color-sabor', src: `${base}music/Ritmo, Color y Sabor.mp3`, title: 'Ritmo, Color y Sabor', description: 'Música tropical peruana.' },
  { id: 'el-alcatraz', src: `${base}music/El Alcatraz.mp3`, title: 'El Alcatraz', description: 'Danza afroperuana tradicional.' },
  { id: 'el-chacombo', src: `${base}music/El Chacombo.mp3`, title: 'El Chacombo', description: 'Ritmo afroperuano festivo.' },
  { id: 'cholo-soy', src: `${base}music/Cholo Soy.mp3`, title: 'Cholo Soy', description: 'Canción de identidad andina.' }
];
---

<Layout title="Música del Perú" hideFooter>
  <div class="page-container musica-page">
    <header class="page-header" data-aos="fade-in">
      <h1>Los Sonidos del Perú</h1>
      <p>La banda sonora de un país diverso, desde los Andes hasta la costa.</p>
    </header>

    <section class="section-container">
      <h2 class="section-title" data-aos="fade-up">Instrumentos con Alma</h2>
      <Gallery images={instruments} client:visible />
    </section>

    <MusicList tracks={tracks} client:visible />
  </div>
</Layout>
